#!/usr/bin/env bash
# passh — 1Password CLI, run where the biometrics are.
#
# On macOS this is a thin wrapper around the local `op`.
# On the server it forwards each invocation over SSH to the Mac, so the
# Touch ID prompt lands on the machine you are actually sitting at.
#
# Secrets travel inside the SSH channel, are held only in shell variables,
# and are never written to disk or passed through any process's argv.

set -euo pipefail

PASSH_HOST="${PASSH_HOST:-100.108.149.42}"
PASSH_USER="${PASSH_USER:-marsh}"
PASSH_REMOTE_OP="${PASSH_REMOTE_OP:-/opt/homebrew/bin/op}"

die() { printf 'passh: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
passh — 1Password CLI, run where the biometrics are.

  passh run --env-file=FILE -- CMD...   resolve op:// refs, run CMD locally
  passh inject [-i FILE] [-o FILE]      resolve op:// refs in a template
  passh read op://VAULT/ITEM/FIELD      print one secret
  passh doctor                          check the link to the Mac
  passh <any other op subcommand>       forwarded verbatim

Prefer `passh run` over `passh read`: it keeps secret values out of your
terminal, your shell history, and any agent's conversation context.

Env: PASSH_HOST, PASSH_USER, PASSH_REMOTE_OP, PASSH_FORCE_REMOTE
EOF
}

# --- guard rails ---------------------------------------------------------
# These would let anyone with shell access here mint a durable credential or
# repoint the CLI at another account, escaping the "no secret at rest on this
# box" property that is the whole point of passh. Blocked in both modes so
# the rule reads identically on every machine.
case "${1:-}" in
  ''|-h|--help|help) usage; exit 0 ;;
  service-account|signin|signout|update|completion)
    die "'$1' is blocked. Run it on the Mac directly if you really mean it." ;;
  account)
    case "${2:-}" in
      add|forget) die "'account $2' is blocked. Run it on the Mac directly." ;;
    esac ;;
esac

passh_is_remote() {
  [[ -n "${PASSH_FORCE_REMOTE:-}" ]] && return 0
  [[ "$(uname -s)" == Darwin ]] && return 1
  return 0
}

b64() { base64 | tr -d '\n'; }

# op_exec STDIN_CONTENT ARGS...
# Empty STDIN_CONTENT means "no stdin". Runs op locally on macOS, otherwise
# over SSH on the Mac. Args are base64'd per-word so they survive whatever
# login shell the far side uses (fish, here) without quoting games.
op_exec() {
  local stdin_content="$1"; shift

  if ! passh_is_remote; then
    if [[ -n $stdin_content ]]; then
      printf '%s' "$stdin_content" | op "$@"
    else
      op "$@" </dev/null
    fi
    return
  fi

  local words="" arg script
  for arg in "$@"; do
    words+=" $(printf '%s' "$arg" | b64)"
  done
  script="set --; for a in$words; do set -- \"\$@\" \"\$(echo \$a|base64 -d)\"; done; "
  if [[ -n $stdin_content ]]; then
    script+="echo $(printf '%s' "$stdin_content" | b64) | base64 -d | $PASSH_REMOTE_OP \"\$@\""
  else
    script+="$PASSH_REMOTE_OP \"\$@\" </dev/null"
  fi

  ssh -n -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
      -o ControlMaster=auto -o ControlPath="$HOME/.ssh/passh-%r@%h:%p" \
      -o ControlPersist=60 \
      "$PASSH_USER@$PASSH_HOST" "/bin/sh -c '$script'"
}

# --- passh run -----------------------------------------------------------
# `op run` cannot be forwarded as-is: it would launch the command on the Mac.
# Instead resolve the env-file on the Mac, then exec the command here with the
# resolved values exported. Same contract as `op run`, split across the hop.
cmd_run() {
  local env_file="" pass_through=() resolved line
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env-file=*) env_file="${1#*=}"; shift ;;
      --env-file)   env_file="${2:-}"; shift 2 ;;
      --account=*)  pass_through+=("$1"); shift ;;
      --account)    pass_through+=("$1" "${2:-}"); shift 2 ;;
      --no-masking) shift ;;   # nothing is echoed back here anyway
      --) shift; break ;;
      -*) die "unrecognised flag for 'passh run': $1" ;;
      *) break ;;
    esac
  done
  [[ -n $env_file ]] || die "'run' needs --env-file=FILE"
  [[ $# -gt 0 ]] || die "'run' needs a command after '--'"
  [[ -r $env_file ]] || die "cannot read env file: $env_file"

  resolved=$(op_exec "$(cat -- "$env_file")" inject ${pass_through[@]+"${pass_through[@]}"})

  # `export` is a builtin, so values never appear in any process's argv.
  while IFS= read -r line; do
    [[ -z $line || $line == \#* || $line != *=* ]] && continue
    export "$line"
  done <<<"$resolved"
  unset resolved

  exec "$@"
}

# --- passh inject --------------------------------------------------------
# -o is handled locally: the output belongs on this machine, not the Mac.
cmd_inject() {
  local in_file="" out_file="" pass_through=() content
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -i|--in-file)  in_file="${2:-}"; shift 2 ;;
      --in-file=*)   in_file="${1#*=}"; shift ;;
      -o|--out-file) out_file="${2:-}"; shift 2 ;;
      --out-file=*)  out_file="${1#*=}"; shift ;;
      -f|--force)    shift ;;
      *) pass_through+=("$1"); shift ;;
    esac
  done

  if [[ -n $in_file ]]; then
    [[ -r $in_file ]] || die "cannot read input file: $in_file"
    content=$(cat -- "$in_file")
  else
    content=$(cat)
  fi
  [[ -n $content ]] || die "'inject' got empty input"

  if [[ -n $out_file ]]; then
    ( umask 077; op_exec "$content" inject ${pass_through[@]+"${pass_through[@]}"} >"$out_file" )
  else
    op_exec "$content" inject ${pass_through[@]+"${pass_through[@]}"}
  fi
}

# --- passh doctor --------------------------------------------------------
cmd_doctor() {
  if ! passh_is_remote; then
    echo "mode:    local (macOS — using the op on this machine)"
    command -v op >/dev/null || die "op not found on PATH"
    echo "op:      $(command -v op) $(op --version)"
    echo "accounts:"; op account list 2>&1 | head -5 || true
    return
  fi
  echo "mode:    remote -> $PASSH_USER@$PASSH_HOST"
  if ssh -n -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new "$PASSH_USER@$PASSH_HOST" true 2>/dev/null; then
    echo "ssh:     ok"
  else
    echo "ssh:     FAILED"
    echo "         Is Remote Login on the Mac enabled, and is this host's key"
    echo "         in the Mac's ~/.ssh/authorized_keys?"
    return 1
  fi
  echo -n "op:      "; op_exec "" --version || { echo "FAILED (is $PASSH_REMOTE_OP correct?)"; return 1; }
  echo "accounts:"; op_exec "" account list || {
    echo "         Reachable, but not authorised — unlock 1Password on the Mac."
    return 1
  }
}

case "$1" in
  run)    shift; cmd_run "$@" ;;
  inject) shift; cmd_inject "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  *)      op_exec "" "$@" ;;
esac
