# oh-my-tmux local overrides
# see: https://github.com/gpakosz/.tmux#configuration

# -- general -----------------------------------------------------------------

# always open panes in fish, regardless of the login shell
# (the login shell is bash on serveserve.local so VS Code Remote-SSH can
# bootstrap its server, which needs a POSIX shell)
if-shell '[ -x /opt/homebrew/bin/fish ]' 'set -g default-shell /opt/homebrew/bin/fish'
if-shell '[ -x /usr/bin/fish ]' 'set -g default-shell /usr/bin/fish'

# start window and pane numbering at 1
set -g base-index 1
setw -g pane-base-index 1

# renumber windows when one is closed
set -g renumber-windows on

# increase history limit
set -g history-limit 10000

# -- display -----------------------------------------------------------------

# true color support
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"

# -- navigation --------------------------------------------------------------

# use vim-style pane navigation
setw -g mode-keys vi

# -- status bar --------------------------------------------------------------

# customize the status bar (oh-my-tmux handles most of this, tweak as needed)
# set -g @theme_status_right_prefix "#{?client_prefix,#[reverse] PREFIX #[noreverse] ,}"

# -- clipboard ---------------------------------------------------------------

# use system clipboard
set -g set-clipboard on

# -- mouse -------------------------------------------------------------------

# mouse support is enabled by default in oh-my-tmux
set -g mouse on

# yank the last command and its output into a paste buffer
# (relies on the OSC 133 prompt marks emitted by fish/conf.d/osc133.fish)
bind-key C-y {
    copy-mode
    send-keys -X previous-prompt
    send-keys -X begin-selection
    send-keys -X next-prompt
    send-keys -X cursor-up
    send-keys -X end-of-line
    send-keys -X copy-selection-and-cancel
}
