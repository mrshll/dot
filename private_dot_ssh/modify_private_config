{{- /* chezmoi:modify-template */ -}}
{{- /*
  ~/.ssh/config is hand-maintained and not in this repo; this only guarantees
  it starts with this machine's managed includes (Mac: the passh forward and
  the marshbox identity; serveserve: the marshbox route) and passes the rest
  through untouched. At the top, because an Include after a Host line applies
  only to that Host, and the first value ssh sees for an option wins.

  It owns only the leading run of this machine's include lines: that run is
  replaced (normalising an older or reordered prefix), and the first other line
  ends it. Includes further down are the user's.
*/ -}}
{{- $prefix := list "Include ~/.ssh/config.d/marshbox" -}}
{{- if eq .chezmoi.os "darwin" }}{{ $prefix = list "Include ~/.ssh/config.d/passh" "Include ~/.ssh/config.d/marshbox" }}{{ end -}}
{{- $lines := splitList "\n" .chezmoi.stdin -}}
{{- $skip := 0 -}}
{{- $leading := true -}}
{{- range $lines -}}
{{-   if and $leading (has (trim .) $prefix) }}{{ $skip = add1 $skip }}{{ else }}{{ $leading = false }}{{ end -}}
{{- end -}}
{{ join "\n" $prefix }}
{{ join "\n" (slice $lines $skip) -}}
