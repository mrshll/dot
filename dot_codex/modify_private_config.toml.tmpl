#!/bin/sh
# Preserve Codex-managed local state; manage only Cloudflare MCP entries and,
# on serveserve, the GitHub identity of the commands Codex runs, Bean's
# writable roots and the sandbox's network access.
set -eu
# serveserve: Codex's commands run gh and git as mrshll-agent: gh reads the
# agents' config (agent-gh --seed), and git authors and signs with its key and
# pushes over HTTPS with that login (dot_config/git/agent.gitconfig.tmpl).
# Marsh's own shells keep ~/.config/gh and ~/.gitconfig. Only these two keys of
# a plain [shell_environment_policy.set] table are managed. Everywhere else,
# and to roll back (set $manage to false), they are removed where they still
# hold exactly these values: nothing but this script puts them there.
#
# serveserve: Codex's workspace-write sandbox can also write Bean's data and
# config (mrshll/pond, bean/), so bean runs without an approval prompt. Both
# paths are appended to sandbox_workspace_write.writable_roots, after whatever
# it already holds. A project .codex/config.toml can't do this: Codex replaces
# arrays layer by layer, so it would drop the roots in this list. To roll back
# (set $bean to false), both paths are removed from the list, whoever put them
# there. Other machines' lists are left as they are.
#
# serveserve: Codex's workspace-write sandbox also has network access, so
# bean refresh can reach Garmin. sandbox_workspace_write.network_access is set
# to true where it is, and added at the end of the table (or the top-level
# dotted keys) where it is not. This opens the network to every workspace-write
# session on serveserve; one started with
# --config sandbox_workspace_write.network_access=... keeps its own value. To
# roll back (set $net to false), the key is removed where it still holds true.
# Other machines' values are left as they are.
{{- $manage := .is_server }}
{{- $bean := .is_server }}
{{- $net := .is_server }}
gitconfig={{ joinPath .chezmoi.homeDir ".config/git/agent.gitconfig" | quote }}
ghconfig={{ joinPath .chezmoi.homeDir ".config/gh-agent" | quote }}
beandata={{ joinPath .chezmoi.homeDir ".local/share/pond/bean" | quote }}
beanconfig={{ joinPath .chezmoi.homeDir ".config/pond/bean" | quote }}
{{ if $manage -}}
manage=1
{{- else -}}
manage=
{{- end }}
{{ if $bean -}}
bean=1
{{- else -}}
bean=
{{- end }}
{{ if $net -}}
net=1
{{- else -}}
net=
{{- end }}
server={{ if .is_server }}1{{ end }}
live=$(cat)
out=$(printf '%s' "$live" | awk -v manage="$manage" -v gitconfig="$gitconfig" -v ghconfig="$ghconfig" \
    -v server="$server" -v bean="$bean" -v beandata="$beandata" -v beanconfig="$beanconfig" -v net="$net" '
# scan(LINE): follow TOML strings and comments through LINE, so instr says
# whether a multi-line string is still open at its end, and depth how many
# arrays are.
function scan(s,   i, n, c) {
    n = length(s); i = 1
    while (i <= n) {
        c = substr(s, i, 1)
        if (instr == "\"\"\"") {
            if (c == "\\") i += 2
            # The delimiter may follow one or two quotes of the string itself.
            else if (substr(s, i, 3) == "\"\"\"") { instr = ""; while (substr(s, i, 1) == "\"") i++ }
            else i++
        } else if (instr == "\047\047\047") {
            if (substr(s, i, 3) == "\047\047\047") { instr = ""; while (substr(s, i, 1) == "\047") i++ }
            else i++
        } else if (c == "#") {
            return
        } else if (substr(s, i, 3) == "\"\"\"" || substr(s, i, 3) == "\047\047\047") {
            instr = substr(s, i, 3); i += 3
        } else if (c == "\"") {
            for (i++; i <= n && substr(s, i, 1) != "\""; i++) if (substr(s, i, 1) == "\\") i++
            i++
        } else if (c == "\047") {
            for (i++; i <= n && substr(s, i, 1) != "\047"; i++) ;
            i++
        } else {
            if (c == "[") depth++
            else if (c == "]") depth--
            i++
        }
    }
}
# holds(KEY, PATH): this line sets KEY to exactly PATH, quoted, then at most a comment.
function holds(key, path,   rest, q, n) {
    if ($0 !~ ("^[ \t]*[\"\047]?" key "[\"\047]?[ \t]*=")) return 0
    rest = $0; sub(/^[^=]*=[ \t]*/, "", rest)
    n = length(path) + 2
    for (q = 1; q <= 2; q++) {
        if (substr(rest, 1, n) == (q == 1 ? "\"" path "\"" : "\047" path "\047") &&
            substr(rest, n + 1) ~ /^[ \t]*(#.*)?$/) return 1
    }
    return 0
}
# lexroots(S): read the array S starts with (the text after "writable_roots ="),
# over lines joined by newlines. Sets nel, raw[k] (each element as written),
# val[k] (its value), comment (one sits inside) and rest (what follows "]").
# Returns 1 once the array closes, 0 if S ends first, and -1 for anything but
# one-line strings without escapes.
function lexroots(s,   i, n, c, j, want) {
    n = length(s); i = 1; nel = 0; comment = 0
    while (substr(s, i, 1) ~ /[ \t]/) i++
    if (substr(s, i, 1) != "[") return -1
    i++; want = "value"
    while (i <= n) {
        c = substr(s, i, 1)
        if (c ~ /[ \t\r\n]/) { i++; continue }
        if (c == "#") {
            comment = 1
            if (!(j = index(substr(s, i), "\n"))) return 0
            i += j; continue
        }
        if (c == "]") { rest = substr(s, i + 1); return (rest ~ /^[ \t\r]*(#.*)?$/) ? 1 : -1 }
        if (c == ",") { if (want != "comma") return -1; want = "value"; i++; continue }
        if (want != "value" || (c != "\"" && c != "\047") || substr(s, i, 3) == c c c) return -1
        if (!(j = index(substr(s, i + 1), c))) return -1
        nel++; raw[nel] = substr(s, i, j + 1); val[nel] = substr(s, i + 1, j - 1)
        if (val[nel] ~ /\n/ || (c == "\"" && val[nel] ~ /\\/)) return -1
        i += j + 1; want = "comma"
    }
    return 0
}
# roots(): writable_roots, gathered in coll, has closed or may have. Print it
# with the Bean paths appended (bean) or removed (not), or as it is if it
# already has them or does not.
function roots(   r, k, n, lines, list, data, config, changed) {
    r = lexroots(substr(coll, index(coll, "=") + 1))
    if (r == 0) { incoll = 1; return }
    incoll = 0; rootsseen = 1
    if (r < 0) { swother = 1; print coll }
    else {
        for (k = 1; k <= nel; k++) {
            if (!bean && (val[k] == beandata || val[k] == beanconfig)) { changed = 1; continue }
            if (val[k] == beandata) data = 1
            if (val[k] == beanconfig) config = 1
            list = list (list == "" ? "" : ", ") raw[k]
        }
        if (bean && !data) { list = list (list == "" ? "" : ", ") "\"" beandata "\""; changed = 1 }
        if (bean && !config) { list = list (list == "" ? "" : ", ") "\"" beanconfig "\""; changed = 1 }
        # Rewriting it on one line would drop a comment inside.
        if (changed && comment) { swother = swfail = 1; print coll }
        else if (changed) print substr(coll, 1, index(coll, "=")) " [" list "]" rest
        else print coll
    }
    # Whatever was printed, follow its strings line by line, as the rest is.
    instr = ""; depth = 0; n = split(coll, lines, "\n")
    for (k = 1; k <= n; k++) scan(lines[k])
}
# pendroots() / pendnet(): this table, or the top level holding
# sandbox_workspace_write dotted keys, still lacks the writable_roots or the
# network_access it gets when it ends. pending(): either.
function insw() { return section == "sw" || (section == "top" && swdotted) }
function pendroots() { return bean && !rootsseen && !added && insw() }
function pendnet() { return net && !netseen && !netadded && insw() }
function pending() { return pendroots() || pendnet() }
# endsection(): give a pending section its writable_roots and network_access,
# before the blank lines and comments that end it.
function endsection(   key) {
    key = section == "top" ? "sandbox_workspace_write." : ""
    if (pendroots()) { print key "writable_roots = " beanroots; added = 1 }
    if (pendnet()) { print key "network_access = true"; netadded = 1 }
    printf "%s", held; held = ""
}
BEGIN {
    if (manage) managed = "GIT_CONFIG_GLOBAL = \"" gitconfig "\"\nGH_CONFIG_DIR = \"" ghconfig "\""
    beanroots = "[\"" beandata "\", \"" beanconfig "\"]"
    section = "top"
}
# Inside writable_roots: gather it until it closes.
incoll { coll = coll "\n" $0; roots(); next }
# Inside a multi-line string: copy it as it is, whatever it looks like.
instr != "" { scan($0); if (!skip) print; next }
# opening: the multi-line string this line leaves open, if any; inarray: this
# line goes on with an array, so a "[" starting it opens an element, not a table.
{ inarray = depth > 0; scan($0); opening = instr }
/^[ \t]*\[/ && !inarray {
    endsection()
    section = ($0 ~ /^[ \t]*\[[ \t]*sandbox_workspace_write[ \t]*\][ \t]*(#.*)?$/) ? "sw" : "other"
    if (section == "sw") swtable = 1
    # Any other spelling of the table (quoted, nested) is one this does not edit.
    else if ($0 ~ /^[ \t]*\[+[ \t]*["\047]?sandbox_workspace_write["\047]?[ \t]*(\]|\.)/) swother = 1
    skip = ($0 ~ /^\[mcp_servers\.(cloudflare|cloudflare-docs|cloudflare-bindings|cloudflare-builds|cloudflare-observability)(\]|\.)/)
    inset = ($0 ~ /^[ \t]*\[[ \t]*shell_environment_policy[ \t]*\.[ \t]*set[ \t]*\][ \t]*(#.*)?$/)
    inpolicy = ($0 ~ /^[ \t]*\[[ \t]*shell_environment_policy[ \t]*\][ \t]*(#.*)?$/)
    # Any other spelling of the table (quoted, nested) is one this does not edit.
    if ($0 ~ /shell_environment_policy/ && !inset && !inpolicy) other = 1
    if (inset && manage) { print; print managed; done = 1; next }
}
# Hold the blank lines and comments that may end a pending section.
pending() && /^[ \t\r]*(#.*)?$/ { held = held $0 "\n"; next }
{ printf "%s", held; held = "" }
# serveserve: writable_roots in the [sandbox_workspace_write] table, or as a
# dotted key at the top level (an inline table there is a form this does not edit).
server && !inarray && (section == "sw" && /^[ \t]*["\047]?writable_roots["\047]?[ \t]*=/ ||
    section == "top" && /^[ \t]*["\047]?sandbox_workspace_write["\047]?[ \t]*\.[ \t]*["\047]?writable_roots["\047]?[ \t]*=/) {
    if (section == "top") swdotted = 1
    coll = $0; roots(); next
}
# serveserve: network_access, in the same two places. It is set to true (net),
# or removed where it holds true (not); any value but true or false is a form
# this does not edit.
server && !inarray && (section == "sw" && /^[ \t]*["\047]?network_access["\047]?[ \t]*=/ ||
    section == "top" && /^[ \t]*["\047]?sandbox_workspace_write["\047]?[ \t]*\.[ \t]*["\047]?network_access["\047]?[ \t]*=/) {
    if (section == "top") swdotted = 1
    netseen = 1
    if ($0 !~ /=[ \t]*(true|false)[ \t]*(#.*)?$/) { netfail = 1; print; next }
    if (net) sub(/=[ \t]*false/, "= true")
    else if ($0 ~ /=[ \t]*true[ \t]*(#.*)?$/) next
    print; next
}
section == "top" && /^[ \t]*["\047]?sandbox_workspace_write["\047]?[ \t]*\./ { swdotted = 1 }
section == "top" && /^[ \t]*["\047]?sandbox_workspace_write["\047]?[ \t]*=/ { swother = 1 }
inset &&/^[ \t]*["\047]?(GIT_CONFIG_GLOBAL|GH_CONFIG_DIR)["\047]?[ \t]*=/ {
    # A multi-line value is not something this edits.
    if (opening != "") other = 1
    # Managed: the table gets these keys with this value, whatever it had.
    if (manage) next
    # Not managed: drop them where they still hold the value set here.
    if (holds("GIT_CONFIG_GLOBAL", gitconfig) || holds("GH_CONFIG_DIR", ghconfig)) next
}
# set as an inline table or dotted keys, at the root or in the policy table.
inpolicy && /^[ \t]*["\047]?set["\047]?[ \t]*[.=]/ { other = 1 }
/^[ \t]*["\047]?shell_environment_policy["\047]?[ \t]*[.=]/ { other = 1 }
!skip { print }
END {
    if (incoll) { swother = rootsseen = 1; print coll }
    endsection()
    needroots = bean && !rootsseen && !added; neednet = net && !netseen && !netadded
    if ((needroots || neednet) && !swtable && !swdotted && !swother) {
        printf "\n[sandbox_workspace_write]\n"
        if (needroots) printf "writable_roots = %s\n", beanroots
        if (neednet) print "network_access = true"
    }
    # Not editing it fails the apply where the Bean paths go in; where they come
    # out, the check below fails it if they are left in.
    if (swfail || bean && swother) {
        print "codex config: sandbox_workspace_write.writable_roots is in a form this script does not edit;" > "/dev/stderr"
        print "  make it an array of one-line strings without escapes or comments inside, in a plain" > "/dev/stderr"
        print "  [sandbox_workspace_write] table or as a top-level dotted key, then apply again" > "/dev/stderr"
        exit 1
    }
    # The same for network_access, where it goes in or holds a value this does not edit.
    if (netfail || net && swother) {
        print "codex config: sandbox_workspace_write.network_access is in a form this script does not edit;" > "/dev/stderr"
        print "  make it network_access = true or false in a plain [sandbox_workspace_write] table" > "/dev/stderr"
        print "  or as a top-level dotted key, then apply again" > "/dev/stderr"
        exit 1
    }
    if (!manage) exit
    if (other) {
        print "codex config: shell_environment_policy.set is in a form this script does not edit;" > "/dev/stderr"
        print "  make it a plain [shell_environment_policy.set] table with one-line values, then apply again" > "/dev/stderr"
        exit 1
    }
    if (!done) printf "\n[shell_environment_policy.set]\n%s\n", managed
}
' &&
cat <<'TOML'
[mcp_servers.cloudflare]
url = "https://mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-docs]
url = "https://docs.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-bindings]
url = "https://bindings.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-builds]
url = "https://builds.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-observability]
url = "https://observability.mcp.cloudflare.com/mcp"
TOML
)
# Never install a config Codex can't load or with the wrong agent environment,
# writable roots or network access: the result must parse, hold both managed
# values when managing and neither agent value otherwise, hold the live
# writable_roots in order with the Bean paths appended or removed, hold
# network_access true on serveserve (or, rolled back, anything but true) and as
# it was elsewhere, and equal the live config in everything else (Cloudflare
# entries aside), or apply fails and leaves the live file as it is. sync.sh's
# ssh shell may not have uv on PATH. Without uv the check is required on
# serveserve, whichever toggles are rolled back, and skipped elsewhere.
uv=$(command -v uv || { for u in "$HOME/.local/bin/uv" /opt/homebrew/bin/uv; do [ -x "$u" ] && echo "$u" && break; done; } || true)
if [ -n "$uv" ]; then
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
printf '%s' "$live" > "$tmp/live.toml"
printf '%s\n' "$out" > "$tmp/out.toml"
"$uv" run --no-project python -I -c '
import sys, tomllib
live_path, out_path, gitconfig, ghconfig, manage, server, bean, net, *bean_roots = sys.argv[1:]
managed = {"GIT_CONFIG_GLOBAL": gitconfig, "GH_CONFIG_DIR": ghconfig}
cloudflare = {"cloudflare", "cloudflare-docs", "cloudflare-bindings", "cloudflare-builds", "cloudflare-observability"}

def load(path, what):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        sys.exit(f"codex config: {what} is not valid TOML ({e}); not applied")

def unmanaged(config):
    config = dict(config)
    policy = dict(config.get("shell_environment_policy", {}))
    env = {k: v for k, v in policy.get("set", {}).items() if k not in managed}
    policy.pop("set", None)
    if env:
        policy["set"] = env
    config.pop("shell_environment_policy", None)
    if policy:
        config["shell_environment_policy"] = policy
    servers = {k: v for k, v in config.get("mcp_servers", {}).items() if k not in cloudflare}
    config.pop("mcp_servers", None)
    if servers:
        config["mcp_servers"] = servers
    sandbox = dict(config.pop("sandbox_workspace_write", {}))
    sandbox.pop("writable_roots", None)
    sandbox.pop("network_access", None)
    if sandbox:
        config["sandbox_workspace_write"] = sandbox
    return config

def roots(config):
    return config.get("sandbox_workspace_write", {}).get("writable_roots", [])

def network(config):
    return config.get("sandbox_workspace_write", {}).get("network_access")

live, out = load(live_path, "the live config"), load(out_path, "the result")
env = out.get("shell_environment_policy", {}).get("set", {})
if manage and any(env.get(k) != v for k, v in managed.items()):
    sys.exit("codex config: the result lacks the agent environment; not applied")
if not manage and any(env.get(k) == v for k, v in managed.items()):
    sys.exit("codex config: the result still holds the agent environment; not applied")
want = [r for r in roots(live) if bean or not server or r not in bean_roots]
want += [r for r in bean_roots if bean and r not in want]
if roots(out) != want:
    sys.exit("codex config: the result does not hold the expected writable_roots; not applied")
want = network(live)
if server and net:
    want = True
elif server and want is True:
    want = None
if network(out) != want or type(network(out)) is not type(want):
    sys.exit("codex config: the result does not hold the expected network_access; not applied")
if unmanaged(live) != unmanaged(out):
    sys.exit("codex config: the result changes more than the managed keys; not applied")
' "$tmp/live.toml" "$tmp/out.toml" "$gitconfig" "$ghconfig" "$manage" "$server" "$bean" "$net" "$beandata" "$beanconfig"
elif [ -n "$server" ]; then
    echo "codex config: uv not found to check the result; not applied" >&2
    exit 1
else
    echo "codex config: uv not found; result not checked" >&2
fi
printf '%s\n' "$out"
