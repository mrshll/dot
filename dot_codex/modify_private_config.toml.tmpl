#!/bin/sh
# Preserve Codex-managed local state; manage only Cloudflare MCP entries and,
# on serveserve, the GitHub identity of the commands Codex runs.
set -eu
# serveserve: Codex's commands run gh and git as mrshll-agent: gh reads the
# agents' config (agent-gh --seed), and git authors and signs with its key and
# pushes over HTTPS with that login (dot_config/git/agent.gitconfig.tmpl).
# Marsh's own shells keep ~/.config/gh and ~/.gitconfig. Only these two keys of
# a plain [shell_environment_policy.set] table are managed. Everywhere else,
# and to roll back (set $manage to false), they are removed where they still
# hold exactly these values: nothing but this script puts them there.
{{- $manage := .is_server }}
gitconfig={{ joinPath .chezmoi.homeDir ".config/git/agent.gitconfig" | quote }}
ghconfig={{ joinPath .chezmoi.homeDir ".config/gh-agent" | quote }}
{{ if $manage -}}
manage=1
{{- else -}}
manage=
{{- end }}
live=$(cat)
out=$(printf '%s' "$live" | awk -v manage="$manage" -v gitconfig="$gitconfig" -v ghconfig="$ghconfig" '
# scan(LINE): follow TOML strings and comments through LINE, so instr says
# whether a multi-line string is still open at its end.
function scan(s,   i, n, c) {
    n = length(s); i = 1
    while (i <= n) {
        c = substr(s, i, 1)
        if (instr == "\"\"\"") {
            if (c == "\\") i += 2
            else if (substr(s, i, 3) == "\"\"\"") { instr = ""; i += 3 }
            else i++
        } else if (instr == "\047\047\047") {
            if (substr(s, i, 3) == "\047\047\047") { instr = ""; i += 3 }
            else i++
        } else if (c == "#") {
            return
        } else if (substr(s, i, 3) == "\"\"\"" || substr(s, i, 3) == "\047\047\047") {
            instr = substr(s, i, 3); i += 3
        } else if (c == "\"") {
            for (i++; i <= n && substr(s, i, 1) != "\""; i++) if (substr(s, i, 1) == "\\") i++
            i++
        } else if (c == "\047") {
            for (i++; i <= n && substr(s, i, 1) != "\047"; i++) ;
            i++
        } else i++
    }
}
# holds(KEY, PATH): this line sets KEY to exactly PATH, quoted, then at most a comment.
function holds(key, path,   rest, q, n) {
    if ($0 !~ ("^[ \t]*[\"\047]?" key "[\"\047]?[ \t]*=")) return 0
    rest = $0; sub(/^[^=]*=[ \t]*/, "", rest)
    n = length(path) + 2
    for (q = 1; q <= 2; q++) {
        if (substr(rest, 1, n) == (q == 1 ? "\"" path "\"" : "\047" path "\047") &&
            substr(rest, n + 1) ~ /^[ \t]*(#.*)?$/) return 1
    }
    return 0
}
BEGIN { if (manage) managed = "GIT_CONFIG_GLOBAL = \"" gitconfig "\"\nGH_CONFIG_DIR = \"" ghconfig "\"" }
# Inside a multi-line string: copy it as it is, whatever it looks like.
instr != "" { scan($0); if (!skip) print; next }
# opening: the multi-line string this line leaves open, if any.
{ scan($0); opening = instr }
/^[ \t]*\[/ {
    skip = ($0 ~ /^\[mcp_servers\.(cloudflare|cloudflare-docs|cloudflare-bindings|cloudflare-builds|cloudflare-observability)(\]|\.)/)
    inset = ($0 ~ /^[ \t]*\[[ \t]*shell_environment_policy[ \t]*\.[ \t]*set[ \t]*\][ \t]*(#.*)?$/)
    inpolicy = ($0 ~ /^[ \t]*\[[ \t]*shell_environment_policy[ \t]*\][ \t]*(#.*)?$/)
    # Any other spelling of the table (quoted, nested) is one this does not edit.
    if ($0 ~ /shell_environment_policy/ && !inset && !inpolicy) other = 1
    if (inset && manage) { print; print managed; done = 1; next }
}
inset && /^[ \t]*["\047]?(GIT_CONFIG_GLOBAL|GH_CONFIG_DIR)["\047]?[ \t]*=/ {
    # A multi-line value is not something this edits.
    if (opening != "") other = 1
    # Managed: the table gets these keys with this value, whatever it had.
    if (manage) next
    # Not managed: drop them where they still hold the value set here.
    if (holds("GIT_CONFIG_GLOBAL", gitconfig) || holds("GH_CONFIG_DIR", ghconfig)) next
}
# set as an inline table or dotted keys, at the root or in the policy table.
inpolicy && /^[ \t]*["\047]?set["\047]?[ \t]*[.=]/ { other = 1 }
/^[ \t]*["\047]?shell_environment_policy["\047]?[ \t]*[.=]/ { other = 1 }
!skip { print }
END {
    if (!manage) exit
    if (other) {
        print "codex config: shell_environment_policy.set is in a form this script does not edit;" > "/dev/stderr"
        print "  make it a plain [shell_environment_policy.set] table with one-line values, then apply again" > "/dev/stderr"
        exit 1
    }
    if (!done) printf "\n[shell_environment_policy.set]\n%s\n", managed
}
' &&
cat <<'TOML'
[mcp_servers.cloudflare]
url = "https://mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-docs]
url = "https://docs.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-bindings]
url = "https://bindings.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-builds]
url = "https://builds.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-observability]
url = "https://observability.mcp.cloudflare.com/mcp"
TOML
)
# Never install a config Codex can't load or with the wrong agent environment:
# the result must parse, hold both managed values when managing and neither
# agent value otherwise, and equal the live config in everything else
# (Cloudflare entries aside), or apply fails and leaves the live file as it
# is. sync.sh's ssh shell may not have uv on PATH. Without uv the check is
# required only where the agent environment is managed.
uv=$(command -v uv || { for u in "$HOME/.local/bin/uv" /opt/homebrew/bin/uv; do [ -x "$u" ] && echo "$u" && break; done; } || true)
if [ -n "$uv" ]; then
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
printf '%s' "$live" > "$tmp/live.toml"
printf '%s\n' "$out" > "$tmp/out.toml"
"$uv" run --no-project python -I -c '
import sys, tomllib
live_path, out_path, gitconfig, ghconfig, manage = sys.argv[1:]
managed = {"GIT_CONFIG_GLOBAL": gitconfig, "GH_CONFIG_DIR": ghconfig}
cloudflare = {"cloudflare", "cloudflare-docs", "cloudflare-bindings", "cloudflare-builds", "cloudflare-observability"}

def load(path, what):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        sys.exit(f"codex config: {what} is not valid TOML ({e}); not applied")

def unmanaged(config):
    config = dict(config)
    policy = dict(config.get("shell_environment_policy", {}))
    env = {k: v for k, v in policy.get("set", {}).items() if k not in managed}
    policy.pop("set", None)
    if env:
        policy["set"] = env
    config.pop("shell_environment_policy", None)
    if policy:
        config["shell_environment_policy"] = policy
    servers = {k: v for k, v in config.get("mcp_servers", {}).items() if k not in cloudflare}
    config.pop("mcp_servers", None)
    if servers:
        config["mcp_servers"] = servers
    return config

live, out = load(live_path, "the live config"), load(out_path, "the result")
env = out.get("shell_environment_policy", {}).get("set", {})
if manage and any(env.get(k) != v for k, v in managed.items()):
    sys.exit("codex config: the result lacks the agent environment; not applied")
if not manage and any(env.get(k) == v for k, v in managed.items()):
    sys.exit("codex config: the result still holds the agent environment; not applied")
if unmanaged(live) != unmanaged(out):
    sys.exit("codex config: the result changes more than the managed keys; not applied")
' "$tmp/live.toml" "$tmp/out.toml" "$gitconfig" "$ghconfig" "$manage"
elif [ -n "$manage" ]; then
    echo "codex config: uv not found to check the result; not applied" >&2
    exit 1
else
    echo "codex config: uv not found; result not checked" >&2
fi
printf '%s\n' "$out"
