#!/bin/sh
# Preserve Codex-managed local state; manage only Cloudflare MCP entries and,
# on serveserve, the GitHub identity of the commands Codex runs.
set -eu
{{ if .is_server -}}
# serveserve: Codex's commands run gh and git as mrshll-agent: gh reads the
# agents' config (agent-gh --seed), and git authors and signs with its key and
# pushes over HTTPS with that login (dot_config/git/agent.gitconfig.tmpl).
# Marsh's own shells keep ~/.config/gh and ~/.gitconfig. Only these keys of
# shell_environment_policy.set are managed; awk -v turns \n into newlines.
managed='GIT_CONFIG_GLOBAL = {{ joinPath .chezmoi.homeDir ".config/git/agent.gitconfig" | quote }}\nGH_CONFIG_DIR = {{ joinPath .chezmoi.homeDir ".config/gh-agent" | quote }}'
{{- else -}}
managed=
{{- end }}
awk -v managed="$managed" '
/^[ \t]*\[/ {
    skip = ($0 ~ /^\[mcp_servers\.(cloudflare|cloudflare-docs|cloudflare-bindings|cloudflare-builds|cloudflare-observability)(\]|\.)/)
    inset = ($0 ~ /^[ \t]*\[[ \t]*shell_environment_policy[ \t]*\.[ \t]*set[ \t]*\][ \t]*(#.*)?$/)
    inpolicy = ($0 ~ /^[ \t]*\[[ \t]*shell_environment_policy[ \t]*\][ \t]*(#.*)?$/)
    # Any other spelling of the table (quoted, nested) is left alone.
    if ($0 ~ /shell_environment_policy/ && !inset && !inpolicy) other = 1
    if (inset && managed != "") { print; print managed; done = 1; next }
}
# The managed keys replace whatever values the table had for them.
inset && managed != "" && /^[ \t]*"?(GIT_CONFIG_GLOBAL|GH_CONFIG_DIR)"?[ \t]*=/ { next }
# set as an inline table or dotted keys: valid TOML this script does not edit.
inpolicy && /^[ \t]*"?set"?[ \t]*[.=]/ { other = 1 }
/^[ \t]*"?shell_environment_policy"?[ \t]*\./ { other = 1 }
!skip { print }
END {
    if (managed == "" || done) exit
    if (other) {
        print "codex config: shell_environment_policy.set is in a form this script does not edit; GIT_CONFIG_GLOBAL and GH_CONFIG_DIR not set" > "/dev/stderr"
        exit
    }
    printf "\n[shell_environment_policy.set]\n%s\n", managed
}
'
cat <<'TOML'
[mcp_servers.cloudflare]
url = "https://mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-docs]
url = "https://docs.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-bindings]
url = "https://bindings.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-builds]
url = "https://builds.mcp.cloudflare.com/mcp"

[mcp_servers.cloudflare-observability]
url = "https://observability.mcp.cloudflare.com/mcp"
TOML
