if status is-interactive
    alias vim nvim
    alias ls eza
    alias ssh "kitten ssh"
    alias ll "eza -la"
    alias tree "eza --tree"
    alias lark "op run --env-file=op.env -- uv run python -m"
{{ if eq .chezmoi.os "linux" -}}
    alias cat batcat
{{ else -}}
    alias cat bat
{{ end -}}
end

{{ if eq .chezmoi.os "darwin" -}}
# macOS: Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

{{- end }}

# Pond
fish_add_path ~/workspace/pond
set -gx POND_SERVER serveserve.local  # pond binaries fall back to Tailscale IP automatically

{{ if eq .chezmoi.os "darwin" -}}
# MPD on serveserve
set -gx MPD_HOST $POND_SERVER
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# opencode (macOS only)
fish_add_path /Users/marsh/.opencode/bin
{{- end }}
