if status is-interactive
    alias vim nvim
    alias ls eza
    alias ll "eza -la"
    alias tree "eza --tree"
{{ if eq .chezmoi.os "linux" -}}
    alias cat batcat
{{ else -}}
    alias cat bat
{{ end -}}
end

{{ if eq .chezmoi.os "darwin" -}}
# macOS: Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# MPD runs on serveserve.local
set -gx MPD_HOST 100.72.11.128
set -gx MPD_PORT 6600
{{- end }}

# Pond
fish_add_path ~/workspace/pond
set -gx POND_SERVER 100.72.11.128

{{ if eq .chezmoi.os "darwin" -}}
# opencode (macOS only)
fish_add_path /Users/marsh/.opencode/bin
{{- end }}
