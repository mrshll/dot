# Git config for agents acting as Marsh's GitHub machine account,
# mrshll-agent. Not read by default: on serveserve, Claude Code and Codex put
# GIT_CONFIG_GLOBAL=<this file> in the environment of every command they run
# (dot_claude/modify_settings.json.tmpl, dot_codex/modify_private_config.toml.tmpl),
# so an agent's commits author and sign as mrshll-agent while Marsh's own shells
# keep ~/.gitconfig. It stands alone rather than including ~/.gitconfig, so
# nothing added there later (a credential, a URL rewrite, an identity) can act
# as Marsh from an agent's shell. Herdr Meta's seat check trusts this file and
# flags those settings anywhere else.
{{- $gh := ternary "/opt/homebrew/bin/gh" "/usr/bin/gh" (eq .chezmoi.os "darwin") }}
[user]
	name = mrshll-agent
	email = 337028807+mrshll-agent@users.noreply.github.com
	signingkey = {{ .chezmoi.homeDir }}/.ssh/mrshll_agent_signing_ed25519
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{/* gh hands git the agents' login, mrshll-agent: agent sessions on serveserve
     also get GH_CONFIG_DIR=~/.config/gh-agent (agent-gh --seed). */ -}}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{/* An SSH remote would push with Marsh's own key, as mrshll. Over HTTPS the
     credential helper hands git the agent's login instead. Only agents get
     this rewrite; Marsh's ~/.gitconfig keeps SSH remotes. */ -}}
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
