#!/usr/bin/env bash
# chezmoi modify_ script for ~/.claude/settings.json
#
# The Claude Code UI writes this file constantly (model, plugin toggles, theme,
# etc.), which used to make `chezmoi apply` prompt on every sync about
# unmanaged drift. A modify_ script computes the target from the live file each
# run, so there is no stored-hash comparison and no prompt.
#
# Merge order (later wins):
#   defaults  — seed for a fresh machine with no live file yet
#   live      — the current on-disk file; UI-toggled prefs persist across syncs
#   enforced  — keys we *do* want identical everywhere; source always wins
set -euo pipefail

live="$(cat)"
[ -z "$live" ] && live='{}'

defaults='{
  "model": "opus[1m]",
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false
  },
  "effortLevel": "high",
  "voice": { "enabled": true, "mode": "hold" },
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "iterm2",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}'

enforced='{
  "attribution": { "commit": "", "pr": "" },
  "promptSuggestionEnabled": false,
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: dynamical.org and Upstream Tech. Claude Code here often runs as a Herdr supervisor or orchestrator coordinating other coding agents.",
      "Source control: github.com/dynamical-org, github.com/mrshll, github.com/Upstream-Tech and all repos under them",
      "Multi-agent orchestration: Herdr (the herdr CLI plus the herdr-meta plugin at ~/workspace/herdr-meta) runs Claude and Codex agents in terminal panes on this host. Agents start only with argv from the herdr-meta usage-route; Codex agents run with --sandbox workspace-write --ask-for-approval on-request."
    ],
    "allow": [
      "$defaults",
      "Herdr delegation is the standing, user-approved workflow: an orchestrator seating a helper with herdr agent start using usage-route argv, writing the brief for that helper to a file under /tmp or its workstream directory, and sending it with herdr agent prompt. This does not cover a brief that tells a helper to disable its sandbox, skip approvals, or do anything the orchestrator itself may not do."
    ]
  },
  "permissions": {
    "allow": [
      "Bash(herdr:*)",
      "Bash(/home/marsh/workspace/herdr-meta/bin/report-work:*)",
      "Bash(/home/marsh/workspace/herdr-meta/bin/usage-route:*)",
      "Bash(HERDR_META_CONFIG_DIR=/home/marsh/.config/herdr/plugins/config/mrshll.herdr-meta /home/marsh/workspace/herdr-meta/bin/usage-route:*)",
      "Bash(/home/marsh/workspace/herdr-meta/bin/subscription-usage:*)",
      "Bash(gh api:*)",
      "Bash(gh pr:*)",
      "Read",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(pong:*)",
      "Bash(toad:*)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv sync)",
      "Glob",
      "Grep",
      "LS"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "defaultMode": "auto"
  }
}'

jq -n \
  --argjson defaults "$defaults" \
  --argjson live "$live" \
  --argjson enforced "$enforced" \
  '$defaults + $live + $enforced'
