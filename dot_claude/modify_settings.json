#!/usr/bin/env bash
# chezmoi modify_ script for ~/.claude/settings.json
#
# The Claude Code UI writes this file constantly (model, plugin toggles, theme,
# etc.), which used to make `chezmoi apply` prompt on every sync about
# unmanaged drift. A modify_ script computes the target from the live file each
# run, so there is no stored-hash comparison and no prompt.
#
# Merge order (later wins):
#   defaults  — seed for a fresh machine with no live file yet
#   live      — the current on-disk file; UI-toggled prefs persist across syncs
#   enforced  — keys we *do* want identical everywhere; source always wins
set -euo pipefail

live="$(cat)"
[ -z "$live" ] && live='{}'

defaults='{
  "model": "opus[1m]",
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false
  },
  "effortLevel": "high",
  "voice": { "enabled": true, "mode": "hold" },
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "iterm2",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}'

enforced='{
  "attribution": { "commit": "", "pr": "" },
  "permissions": {
    "allow": [
      "Read",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(pong:*)",
      "Bash(toad:*)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv sync)",
      "Glob",
      "Grep",
      "LS"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "defaultMode": "auto"
  }
}'

jq -n \
  --argjson defaults "$defaults" \
  --argjson live "$live" \
  --argjson enforced "$enforced" \
  '$defaults + $live + $enforced'
