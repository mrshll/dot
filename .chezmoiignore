# kitty and espanso are macOS-only (GUI-only; the server is headless)
{{ if ne .chezmoi.os "darwin" }}
.config/kitty
.config/espanso
.local/bin/herdr-desk
{{ end }}

# passhd and its launch agent are macOS-only: the Mac is the machine with the
# biometrics, so it runs the daemon. The server only ever runs the passh client.
{{ if ne .chezmoi.os "darwin" }}
.local/bin/passhd
Library
{{ end }}

# The passh RemoteForward belongs on the machine I SSH *from*: the Mac. A server
# carrying it onward would hand its tunnel to every host it reaches.
{{ if ne .chezmoi.os "darwin" }}
.ssh/config.d/passh
{{ end }}

# serveserve's route to marshbox, so sync.sh can run there (config.d/marshbox).
{{ if not .is_server }}
.ssh/config.d/marshbox
.ssh/known_hosts.d
{{ end }}

# ~/.ssh/config is touched only where one of those fragments applies.
{{ if and (ne .chezmoi.os "darwin") (not .is_server) }}
.ssh/config
.ssh/config.d
{{ end }}

# the pytest guard only makes sense on the shared server (see machine.fish.tmpl)
{{ if not .is_server }}
.config/pytest-local
{{ end }}

# espanso hub packages are installed with `espanso install`, not tracked here
.config/espanso/match/packages

# lazy-lock.json and lazyvim.json are machine-local state
.config/nvim/lazy-lock.json
.config/nvim/lazyvim.json


# conf.d/local.fish is the untracked escape hatch for machine-specific shell
# bits not worth committing (version-pinned installer paths, experiments).
# The tracked counterpart is conf.d/machine.fish.tmpl.
.config/fish/conf.d/local.fish

# fish_variables are machine-local (color theme, universal vars)
.config/fish/fish_variables

# gh hosts contain auth tokens — managed per-machine by `gh auth login`
.config/gh/hosts.yml
