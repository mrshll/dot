# Apps
# AeroSpace is an i3-like tiling WM; it lives in a third-party tap, which
# Homebrew now requires an explicit one-time trust for:
#   brew tap nikitabobko/tap && brew trust nikitabobko/tap
tap "nikitabobko/tap"
cask "nikitabobko/tap/aerospace"
# Deskflow shares this keyboard and mouse with marshbox. Same one-time trust:
#   brew tap deskflow/tap && brew trust deskflow/tap
tap "deskflow/tap"
cask "deskflow/tap/deskflow"
cask "1password-cli"
cask "espanso"
cask "google-chrome"
cask "kitty"
cask "localsend"
cask "obsidian"
cask "vlc"
