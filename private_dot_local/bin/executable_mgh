#!/usr/bin/env bash
# Act on GitHub as Marsh himself, mrshll.
#
#   mgh <gh args...>    e.g. mgh pr merge 12
#   mgh git <args...>   e.g. mgh git push
#
# On serveserve the stored GitHub login is the machine account, mrshll-agent
# (agent-gh --seed), and Marsh's is deliberately absent. This injects his token
# from 1Password through passh for one command, so acting as mrshll always
# takes his approval at the Mac. SSH GitHub remotes go over HTTPS for the
# command, so git pushes with that token, not with whatever key ssh offers.
# Only authentication changes: `mgh git commit` authors and signs as the
# checkout's git config says.
set -euo pipefail

# TODO(Marsh): the op:// reference for mrshll's GitHub token.
MARSH_TOKEN_REF='op://Private/REPLACE-ME/token'

[ $# -gt 0 ] || { printf 'usage: mgh <gh args...> | mgh git <args...>\n' >&2; exit 64; }
[ "$1" = git ] || set -- gh "$@"

unset GITHUB_TOKEN
export GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=2 \
    GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_0=git@github.com: \
    GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_1=ssh://git@github.com/
# An empty token would leave gh on the stored login, mrshll-agent.
exec passh run --env-file=<(printf 'GH_TOKEN=%s\n' "$MARSH_TOKEN_REF") -- bash -c '
    [ -n "${GH_TOKEN-}" ] || { echo "mgh: no token from 1Password" >&2; exit 1; }
    exec "$@"' mgh "$@"
