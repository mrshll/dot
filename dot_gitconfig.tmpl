[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = mrsll
	email = m@mrshll.com
{{- if eq .chezmoi.os "darwin" }}
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOLRfIvUP4+pblDUzkqEQOgZ01t08UAaq6ia6K0YCmoN
{{- else if .is_server }}
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519
{{- else }}
{{- /* Only serveserve keeps a signing key on disk. Elsewhere name the 1Password
       key by its public literal, never a path: mono's devcontainer
       initialize.sh copies a path-valued signingkey's file into the workspace,
       private keys included. Signing then needs an agent holding that key. */}}
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOLRfIvUP4+pblDUzkqEQOgZ01t08UAaq6ia6K0YCmoN
{{- end }}
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[gpg]
	format = ssh
{{/* macOS signs via 1Password. serveserve has ssh-keygen sign from its on-disk
     key: a forwarded agent only lives as long as the SSH session, so herdr panes
     — which outlive it — could not sign. Other Linux boxes sign through an agent
     holding the 1Password key. Both keys are in allowed_signers. */ -}}
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
{{- $gh := ternary "/opt/homebrew/bin/gh" "/usr/bin/gh" (eq .chezmoi.os "darwin") }}
{{/* Written by `gh auth setup-git`; the empty helper resets any inherited list. */ -}}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
