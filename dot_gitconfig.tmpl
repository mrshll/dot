[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = mrsll
	email = m@mrshll.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOLRfIvUP4+pblDUzkqEQOgZ01t08UAaq6ia6K0YCmoN
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
{{/* macOS signs via 1Password; elsewhere git's default ssh-keygen signs against
     the forwarded agent, which carries the same key. */ -}}
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
{{- $gh := ternary "/opt/homebrew/bin/gh" "/usr/bin/gh" (eq .chezmoi.os "darwin") }}
{{/* Written by `gh auth setup-git`; the empty helper resets any inherited list. */ -}}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
